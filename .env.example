# ---------- Shared ----------
DATABASE_URL=postgresql://schm:schm@localhost:5432/schm?schema=public
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info

# RPC providers (can also be changed at runtime in Settings). Mainnet has no default.
# A comma-separated list adds backups, used in order when the primary fails or falls behind.
TESTNET_RPC_URL=https://soroban-testnet.stellar.org
MAINNET_RPC_URL=
FUTURENET_RPC_URL=https://rpc-futurenet.stellar.org
LOCAL_RPC_URL=http://localhost:8000/rpc

# Encrypts webhook secrets at rest. Required in production; the API and worker must share it.
# Generate with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# ---------- API ----------
API_PORT=4000
API_HOST=0.0.0.0
# Bootstrap admin token. Use it to sign in to the dashboard and create named API tokens.
# Generate with: openssl rand -hex 32
ADMIN_API_TOKEN=change-me-to-a-long-random-string
# Requests per minute per client IP (shared across API replicas through Redis).
RATE_LIMIT_PER_MINUTE=600
# Comma-separated list of allowed browser origins (the dashboard calls the API server-side, so usually empty).
CORS_ORIGINS=
# Default number of ledgers to backfill when a contract is registered (~17280 ledgers/day).
INITIAL_LOOKBACK_LEDGERS=17280

# ---------- Worker ----------
WORKER_METRICS_PORT=4001
# Caught-up contracts polled together in one RPC call (1-25), and how far behind a contract may be
# and still join a batch.
INGEST_BATCH_SIZE=25
INGEST_BATCH_MAX_LAG_LEDGERS=1000
INGEST_INTERVAL_MS=10000
STORAGE_CHECK_INTERVAL_MS=300000
INACTIVITY_CHECK_INTERVAL_MS=60000
EVENT_RETENTION_DAYS=30
# Delete audit log entries after N days (0 = keep forever)
AUDIT_LOG_RETENTION_DAYS=365
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=6
# Disable a destination after N failed deliveries in a row over at least H hours (0 = never)
DESTINATION_DISABLE_AFTER_FAILURES=20
DESTINATION_DISABLE_MIN_HOURS=24
# Block webhooks to private/loopback addresses (recommended in production).
WEBHOOK_BLOCK_PRIVATE_IPS=false

# Email notifications (optional). Leave SMTP_HOST empty to disable email destinations.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Stellar Health Monitor <alerts@example.com>"

# ---------- Web ----------
# URL the Next.js server uses to reach the API.
API_URL=http://localhost:4000
# Public URL of the dashboard, used for links in notifications.
PUBLIC_DASHBOARD_URL=http://localhost:3000
# Set to true when serving the dashboard over HTTPS so the session cookie is Secure.
SESSION_COOKIE_SECURE=false

# ---------- docker-compose.yml (production stack) ----------
# Password for the bundled Postgres container.
POSTGRES_PASSWORD=
# Host port the dashboard is published on.
WEB_PORT=3000
# Optional bearer token required to scrape the API's /metrics endpoint.
METRICS_TOKEN=
