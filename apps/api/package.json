{
  "name": "@stellar-health/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir test/unit",
    "test:integration": "vitest run --dir test/integration --no-file-parallelism"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "6.19.3",
    "@stellar-health/alert-engine": "workspace:*",
    "@stellar-health/db": "workspace:*",
    "@stellar-health/shared-types": "workspace:*",
    "@stellar-health/stellar-client": "workspace:*",
    "@stellar/stellar-sdk": "~16.3.1",
    "bullmq": "^6.3.13",
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.7.0",
    "prisma": "6.19.3",
    "prom-client": "^15.1.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0"
  }
}
